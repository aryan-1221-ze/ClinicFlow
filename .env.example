# Copy this file to ".env" and edit. Never commit ".env".

# Required for stable sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional: set "1" when serving over HTTPS so session cookies are marked Secure.
SESSION_COOKIE_SECURE=0

# Optional: where the SQLite file lives (default: database/clinicflow.db)
# DATABASE_PATH=

# Optional: load fictional demo appointments + sample doctors on first run (1/0)
AUTO_SEED=1

# Upload limits for the doctor CSV importer
MAX_UPLOAD_BYTES=1048576
MAX_CSV_ROWS=5000

# ---- AI assistant (all optional) ----
# Leave both keys empty to use the labelled fallback templates.
# Set ONE key. If both are set, Anthropic is used unless AI_PROVIDER says otherwise.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# anthropic | openai | none   (none forces the fallback even if a key exists)
AI_PROVIDER=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o-mini
